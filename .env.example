# SceneForge 根目录环境变量样例
# 用法：复制为本文件同级的 .env 后按需修改（已有 .env 时不要覆盖）
#   macOS / Linux: [ -f .env ] || cp .env.example .env
#   Windows PowerShell: if (!(Test-Path .env)) { Copy-Item .env.example .env }
# 说明：
# - 本地源码启动会读取本文件；Docker Compose 也会读取本文件注入容器。
# - Docker 部署时服务端容器内的 POSTGRES_HOST / REDIS_HOST 由 compose 固定为服务名，无需在此改成容器名。
# - 前端本地开发另需配置 web/.env.local（见 web/.env.example），不会读取本文件。
# - 生成 APP_SECRET_KEY：openssl rand -hex 32

# ---------- 必填 ----------
# 应用密钥，至少 32 字节高强度随机值，用于签名与敏感字段加密；生产环境务必更换且勿提交仓库
APP_SECRET_KEY=
# 浏览器可访问的前端根地址（仅 HTTP/HTTPS，不要带路径或查询参数）
# 本地 Next.js 开发默认端口为 5555；Docker 经 Nginx 入口时按实际域名填写
FRONTEND_BASE_URL=http://127.0.0.1:5555

# ---------- 服务端 ----------
SERVER_PORT=8080
TZ=Asia/Shanghai
LOG_LEVEL=INFO
TOKEN_EXPIRE_HOURS=24
# 反代场景建议配置可信代理地址/网段，便于解析真实客户端 IP；本地开发可留空
TRUSTED_PROXY_ADDRESSES=
# CORS 允许的 Origin 模式，多个用英文逗号分隔
CORS_ALLOWED_ORIGIN_PATTERNS=http://localhost:5555,http://127.0.0.1:5555,https://www.sceneforge.cn
SERVER_MAX_IN_MEMORY_SIZE=60MB
SERVER_MAX_FILE_SIZE=50MB
SERVER_MAX_MULTIPART_PARTS=16

# ---------- 初始管理员（首次启动写入；公网部署前必须修改密码） ----------
ADMIN_INITIAL_EMAIL=admin@admin.com
ADMIN_INITIAL_PASSWORD=sceneforge@pwss
ADMIN_INITIAL_NICKNAME=admin

# ---------- PostgreSQL ----------
# 本地源码启动连本机时使用 127.0.0.1；Compose 中 server 容器会覆盖为服务名 postgres
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_USERNAME=postgres
POSTGRES_PASSWORD=123456
POSTGRES_DATABASE=scene_forge
# 自动建库时连接的管理库；账号需具备 CREATEDB 权限
POSTGRES_ADMINISTRATOR_DATABASE=postgres
POSTGRES_MAX_POOL_SIZE=20
POSTGRES_MIN_IDLE=5
# 新建开源库默认 community；继承企业版已有库时改为 classpath:db/migration
FLYWAY_MIGRATION_LOCATION=classpath:db/migration-community

# ---------- Redis ----------
# 本地源码启动连本机时使用 127.0.0.1；Compose 中 server 容器会覆盖为服务名 redis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
# 默认 Compose Redis 不启用认证，留空即可
REDIS_PASSWORD=
REDIS_DATABASE=0

# ---------- AI 任务与视频合成（可选，有默认值） ----------
AI_TASK_POLLING_INTERVAL_SECONDS=3
AI_TASK_CONSUMER_CONCURRENCY=4
AI_TASK_READ_BATCH_SIZE=4
AI_TASK_READ_BLOCK_SECONDS=5
AI_TASK_LOCK_TTL_SECONDS=300
AI_TASK_LOCK_RENEW_SECONDS=60
AI_TASK_PENDING_CLAIM_IDLE_SECONDS=300
AI_TASK_RUNNING_RECOVER_SECONDS=900
AI_TASK_STREAM_KEY=sceneforge:ai-task:stream
AI_TASK_CONSUMER_GROUP=sceneforge-ai-task-consumer
AI_VIDEO_COMPOSITION_CONCURRENCY=1
AI_VIDEO_COMPOSITION_MAXIMUM_INPUT_BYTES=524288000
AI_VIDEO_COMPOSITION_MAXIMUM_TOTAL_DURATION_SECONDS=600
AI_VIDEO_COMPOSITION_ACTIVE_LEASE_SECONDS=180
AI_VIDEO_COMPOSITION_LEASE_RENEW_SECONDS=60
AI_VIDEO_COMPOSITION_FFMPEG_EXECUTABLE=ffmpeg
AI_VIDEO_COMPOSITION_FFPROBE_EXECUTABLE=ffprobe
AI_STORYBOARD_COMPOSE_CONCURRENCY=4
AI_IMAGE_HTTP_RESULT_UPLOAD_TO_OBJECT_STORAGE=false

# ---------- 对象存储签名（可选） ----------
STORAGE_REQUIRE_PRIVATE_BUCKET=false
STORAGE_SIGN_PREVIEW_SECONDS=3600
STORAGE_SIGN_DOWNLOAD_SECONDS=300
STORAGE_SIGN_THIRD_PARTY_SECONDS=7200
STORAGE_SIGN_PUBLIC_PAGE_SECONDS=1800
TENCENT_COS_MAX_ERROR_RETRY=3

# ---------- 邮件群发限流（SMTP 本身在管理后台配置） ----------
EMAIL_CAMPAIGN_MINIMUM_INTERVAL_SECONDS=3
EMAIL_CAMPAIGN_MAXIMUM_PER_MINUTE=20
EMAIL_CAMPAIGN_MAXIMUM_PER_HOUR=200
EMAIL_CAMPAIGN_MAXIMUM_ACTIVE_CAMPAIGNS=20

# ---------- Docker Compose 镜像与容器（可选） ----------
IMAGE_TAG=latest
WEB_IMAGE_NAME=sceneforge-web
SERVER_IMAGE_NAME=sceneforge-server
WEB_PORT=5550
POSTGRES_CONTAINER_NAME=sceneforge-postgres
REDIS_CONTAINER_NAME=sceneforge-redis
WEB_CONTAINER_NAME=sceneforge-web
SERVER_CONTAINER_NAME=sceneforge-server
NGINX_CONTAINER_NAME=sceneforge-pro-nginx
NGINX_LOCAL_CONTAINER_NAME=sceneforge-nginx
NGINX_PORT=5554
NGINX_CONFIG_DIRECTORY=./nginx
NGINX_STATIC_DIRECTORY=./volume/nginx_static
NGINX_LOG_DIRECTORY=./logs/nginx
NGINX_SSL_DIRECTORY=./volume/nginx_ssl

# ---------- 前端构建注入（Docker 构建 web 镜像时使用；本地开发请改 web/.env.local） ----------
NEXT_PUBLIC_CREDIT_STORE_URL=
NEXT_PUBLIC_ICP_RECORD_NUMBER=
NEXT_PUBLIC_GITHUB_URL=https://github.com/Swayingleaves/sceneforge
